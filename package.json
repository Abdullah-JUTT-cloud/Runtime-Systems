{
  "name": "runtime-systems-flagship",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run sync:knowledge && vite build && node scripts/generate-routes.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "sync:knowledge": "node scripts/sync-knowledge.mjs",
    "pages:dev": "npm run sync:knowledge && npm run build && wrangler pages dev dist"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@fontsource/manrope": "^5.1.1",
    "@fontsource/syne": "^5.1.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/three": "^0.180.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "electron-to-chromium": "1.5.395"
  }
}
